# HongGuoAD.list
# 红果短剧 / 字节广告过滤
# 适用于 Clash/Mihomo 经 Subconverter 生成的经典规则。
# 透明网关场景：仅按域名/IP 过滤，不按 App 包名过滤。

# 广告请求与落地页
DOMAIN,ad.toutiao.com
DOMAIN,ad.zijieapi.com
DOMAIN,ad.oceanengine.com
DOMAIN,clue.oceanengine.com

# 字节广告 SDK
DOMAIN,pangolin.snssdk.com
DOMAIN,mcs.snssdk.com
DOMAIN,security-lq.snssdk.com
DOMAIN,activity-ag.awemeughun.com

DOMAIN-SUFFIX,pangolin-sdk-toutiao.com
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com
DOMAIN-SUFFIX,pangolin-sdk-toutiao2.com
DOMAIN-SUFFIX,pangolin-sdk-toutiao3.com
DOMAIN-SUFFIX,pangolin-sdk-toutiao4.com
DOMAIN-SUFFIX,pangolin-sdk-toutiao5.com

DOMAIN-SUFFIX,pglstatp-toutiao.com

# 广告调度分片
DOMAIN,ads3-normal-hl.zijieapi.com
DOMAIN,ads3-normal-lf.zijieapi.com
DOMAIN,ads3-normal-lq.zijieapi.com
DOMAIN,ads3-normal.zijieapi.com
DOMAIN,ads5-normal-hl.zijieapi.com
DOMAIN,ads5-normal-lf.zijieapi.com
DOMAIN,ads5-normal-lq.zijieapi.com
DOMAIN,ads5-normal.zijieapi.com

# 广告素材分片（服务端可轮换 p1-p9）
DOMAIN,p1-ad-sign.byteimg.com
DOMAIN,p2-ad-sign.byteimg.com
DOMAIN,p3-ad-sign.byteimg.com
DOMAIN,p4-ad-sign.byteimg.com
DOMAIN,p5-ad-sign.byteimg.com
DOMAIN,p6-ad-sign.byteimg.com
DOMAIN,p7-ad-sign.byteimg.com
DOMAIN,p8-ad-sign.byteimg.com
DOMAIN,p9-ad-sign.byteimg.com

# 广告日志/实时上报
DOMAIN,log3-applog-hl.fqnovel.com
DOMAIN,log3-applog-lf.fqnovel.com
DOMAIN,log3-applog-lq.fqnovel.com
DOMAIN,log3-applog.fqnovel.com
